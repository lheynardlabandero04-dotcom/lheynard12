def quiz(questions):
    score = 0

    print("\n================================")
    print("             SHORT QUIZ")
    print("================================")

    for number, question in enumerate(questions, 1):
        print("\n" + str(number) + ". " + question[0])
        print(question[1])
        print(question[2])

        answer = input("\nAnswer: ").strip().upper()

        if answer == question[3]:
            print("Correct! Great job!")
            score += 1
        elif answer in ["A", "B"]:
            print("Wrong! The correct answer is letter",
                  question[3])
        else:
            print("Invalid answer.")

    print("\n================================")
    print("          QUIZ RESULTS")
    print("================================")
    print("Your Score:", score, "/ 3")

    if score == 3:
        print("Excellent! Perfect score!")
    elif score == 2:
        print("Very Good! Keep practicing!")
    elif score == 1:
        print("Good try! Study the lesson again.")
    else:
        print("Don't give up! Keep learning!")

    print("================================")


